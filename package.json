{
  "name": "chimerai",
  "version": "1.0.0",
  "description": "Chimerai — Agentic AI Hackathon by Devoteam",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter chimerai-web dev --host 0.0.0.0",
    "dev:api": "bash apps/api/run_dev.sh",
    "dev": "pnpm run dev:web & pnpm run dev:api",
    "build:web": "pnpm --filter chimerai-web build",
    "build": "pnpm run build:web",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "typecheck": "pnpm --filter chimerai-web check && pnpm --filter @chimerai/types typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1"
}
